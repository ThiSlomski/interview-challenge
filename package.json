{
  "name": "frontend-challenge",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/database/config.test.mjs tests/registration/validation.test.mjs tests/registration/server-runner.test.mjs tests/auth/server-runner.test.mjs tests/authorization/server-runner.test.mjs tests/weather/weather.test.mjs tests/profile/validation.test.mjs tests/profile/server-runner.test.mjs",
    "test:profile:server": "node --conditions=react-server --test tests/profile/server.test.mjs",
    "test:profile:ui": "node --test tests/profile/ui.test.mjs",
    "test:registration:server": "node --conditions=react-server --test tests/registration/server.test.mjs",
    "test:auth:server": "node --conditions=react-server --test tests/auth/server.test.mjs",
    "test:db:integration": "node --test tests/database/integration.test.mjs",
    "db:inspect": "node scripts/database/cli.mjs inspect",
    "db:provision": "node scripts/database/cli.mjs provision",
    "db:migrate": "node scripts/database/cli.mjs migrate",
    "db:grant": "node scripts/database/cli.mjs grant",
    "db:check": "node scripts/database/cli.mjs check-app",
    "test:authorization:server": "node --conditions=react-server --test tests/authorization/server.test.mjs",
    "db:promote-admin": "node scripts/database/admin-user-cli.mjs",
    "test:ui": "node --test tests/ui/integration.test.mjs",
    "test:weather": "node --test tests/weather/weather.test.mjs",
    "test:weather:ui": "node --test tests/weather/ui.test.mjs"
  },
  "dependencies": {
    "@node-rs/argon2": "2.2.2",
    "axios": "1.20.0",
    "next": "16.4.3",
    "pg": "8.23.1",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "20.11.20",
    "@types/pg": "8.23.1",
    "@types/react": "18.2.58",
    "@types/react-dom": "18.2.19",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "node-pg-migrate": "9.0.0",
    "typescript": "5.3.3"
  }
}
