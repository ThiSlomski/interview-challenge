# Exemplo de variáveis de ambiente. Copie para `.env.local` (ignorado pelo git)
# e preencha com valores reais. NUNCA faça commit do seu .env com segredos.
#
# cp .env.example .env.local

# --- Banco de dados ---
# Exemplos (escolha o seu banco e ajuste):
#   Postgres: postgresql://user:password@localhost:5432/challenge
#   SQLite:   file:./dev.db
DATABASE_URL=

# --- Autenticação / sessão ---
# Segredo usado para assinar sessões/JWT. Gere um valor forte e aleatório
# (ex.: `openssl rand -base64 32`). NUNCA reutilize entre ambientes.
AUTH_SECRET=
# Duração da sessão/token (ex.: 3600 = 1h). Ajuste conforme sua estratégia.
SESSION_TTL_SECONDS=3600

# --- API de previsão do tempo ---
# Se a API escolhida exigir chave (ex.: OpenWeather). Open-Meteo não exige.
WEATHER_API_BASE_URL=
WEATHER_API_KEY=

# --- App ---
# NODE_ENV=development
