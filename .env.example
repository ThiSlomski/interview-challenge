# Copie manualmente para .env.local (ignorado); nunca envie valores no chat.
# Destino exclusivo desta etapa: 127.0.0.1:5432 / imobilead.
# Substitua os placeholders localmente; URL-encode caracteres especiais da senha.
DATABASE_URL=postgresql://imobilead_app:REPLACE_LOCALLY@127.0.0.1:5432/imobilead
MIGRATION_DATABASE_URL=postgresql://imobilead_migrate:REPLACE_LOCALLY@127.0.0.1:5432/imobilead
# Só para provisionar roles/schemas/grants; nunca para rodar a aplicação.
ADMIN_DATABASE_URL=postgresql://postgres:REPLACE_LOCALLY@127.0.0.1:5432/imobilead
# true somente após confirmar remoção do trust temporário no ambiente local.
DB_TRUST_REMOVED=false
# Sessões futuras: validade absoluta de uma hora, sem renovação.
SESSION_TTL_SECONDS=3600
WEATHER_API_BASE_URL=
WEATHER_API_KEY=
# Integração: execução pendente de autorização de banco descartável e credenciais.
# TEST_ADMIN_DATABASE_URL=<URL local do administrador, sem valores versionados>
# DB_DISPOSABLE_TEST_AUTHORIZED=false
# Origem pública exata autorizada para POST /api/users; obrigatória em produção.
APP_ORIGIN=http://localhost:3000
